# Copy to .env (gitignored) before `docker compose up`.
# Generate each secret: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# ---- MySQL -----------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root
DB_NAME=overnight_oats
DB_USER=oats
DB_PASSWORD=change-me-app

# ---- API -------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string

# Password given to the seeded @orderko.test accounts by `npm run db:setup`.
# The API refuses to seed the documented default when NODE_ENV=production.
SEED_PASSWORD=change-me-too

# ---- Site ------------------------------------------------------------------
# A bare domain here makes Caddy fetch a Let's Encrypt certificate.
# Leave blank to serve plain HTTP on HTTP_PORT.
SITE_ADDRESS=
PUBLIC_BASE_URL=http://localhost
HTTP_PORT=80
HTTPS_PORT=443

# ---- Grab ------------------------------------------------------------------
GRAB_MODE=mock
GRAB_CLIENT_ID=
GRAB_CLIENT_SECRET=
GRAB_WEBHOOK_SECRET=
