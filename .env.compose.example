# Copy to .env (gitignored) before `docker compose up`.
# Generate each secret: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# ---- API -------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string

# Password given to the seeded @orderko.test accounts when the store is first
# created. The API refuses to start in production with the documented default.
SEED_PASSWORD=change-me-too

# ---- Site ------------------------------------------------------------------
# A bare domain here makes Caddy fetch a Let's Encrypt certificate.
# Leave blank to serve plain HTTP on HTTP_PORT.
SITE_ADDRESS=
PUBLIC_BASE_URL=http://localhost
HTTP_PORT=80
HTTPS_PORT=443

# ---- Grab ------------------------------------------------------------------
# sim  = simulated driver, advances on a timer
# live = GrabExpress partner API (needs the credentials below)
GRAB_MODE=sim
GRAB_AUTO_ADVANCE_SECONDS=25
GRAB_CLIENT_ID=
GRAB_CLIENT_SECRET=
GRAB_WEBHOOK_SECRET=
