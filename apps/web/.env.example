# Copy to apps/web/.env.local to override for local development.
#
# Left unset, the app calls /api and Vite proxies that to localhost:4000.
# A deployed build needs the API's absolute URL, including the /api suffix.
#
# VITE_API_BASE_URL=https://your-api.onrender.com/api

# Sub-path the bundle is served from. GitHub Pages project sites need this;
# the deploy workflow sets it, so you rarely set it by hand.
# VITE_BASE=/orderko/
