# Copy to apps/api/.env and fill in.

NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# ---- MySQL -----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=overnight_oats

# ---- Auth ------------------------------------------------------------------
# Required in production. Generate one: node -e "console.log(crypto.randomUUID())"
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=12h

# Password applied to the seeded @orderko.test accounts by `npm run db:setup`.
SEED_PASSWORD=Password123!

# ---- Grab delivery ---------------------------------------------------------
# mock = simulated driver, no credentials needed.
# live = GrabExpress partner API; requires the client id/secret below.
GRAB_MODE=mock

# Seconds between simulated driver state changes when GRAB_MODE=mock.
GRAB_MOCK_TICK_SECONDS=20

# Staging endpoints. For production use:
#   GRAB_BASE_URL=https://partner-api.grab.com/grabexpress
#   GRAB_AUTH_URL=https://api.grab.com/grabid/v1/oauth2/token
GRAB_BASE_URL=https://partner-api.stg-myteksi.com/grabexpress
GRAB_AUTH_URL=https://api.stg-myteksi.com/grabid/v1/oauth2/token
GRAB_CLIENT_ID=
GRAB_CLIENT_SECRET=
GRAB_SERVICE_TYPE=INSTANT

# Shared secret Grab signs webhook bodies with. Leave blank to skip the check
# (development only).
GRAB_WEBHOOK_SECRET=
