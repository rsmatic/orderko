# Copy to apps/api/.env and fill in. Every value has a working default for
# local development, so an empty file is fine to start with.

NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# ---- Storage ---------------------------------------------------------------
# The whole database is this one JSON file, relative to apps/api/.
# It seeds itself on first run. In production point this at a mounted volume.
DATA_FILE=data/store.json

# ---- Auth ------------------------------------------------------------------
# Required in production. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=12h

# Password given to the seeded @orderko.test accounts when the store is first
# created. The API refuses to start in production while this is the default.
SEED_PASSWORD=Password123!

# ---- Grab delivery ---------------------------------------------------------
# sim  = simulated driver, no credentials needed
# live = GrabExpress partner API
GRAB_MODE=sim

# Seconds between automatic driver-state changes in sim mode. 0 disables the
# timer, leaving the Advance button as the only way to move a delivery.
GRAB_AUTO_ADVANCE_SECONDS=25

# Staging endpoints. For production:
#   GRAB_BASE_URL=https://partner-api.grab.com/grabexpress
#   GRAB_AUTH_URL=https://api.grab.com/grabid/v1/oauth2/token
GRAB_BASE_URL=https://partner-api.stg-myteksi.com/grabexpress
GRAB_AUTH_URL=https://api.stg-myteksi.com/grabid/v1/oauth2/token
GRAB_CLIENT_ID=
GRAB_CLIENT_SECRET=
GRAB_SERVICE_TYPE=INSTANT

# Shared secret Grab signs webhook bodies with. Blank skips the check
# (development only).
GRAB_WEBHOOK_SECRET=
